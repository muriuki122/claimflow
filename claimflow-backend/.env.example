OPENAI_API_KEY=your_openai_api_key_here
CLAIMFLOW_MODEL_CACHE_DIR=storage/model_cache
CLAIMFLOW_DOCUMENT_FOLDER=DOCUMENT
CLAIMFLOW_MAX_PAGES=3
